{
  "name": "LibLookup",
  "version": "0.0.11-alpha",
  "description": "Connect to various library catalogs",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "electron .",
    "build": "electron-builder build --publish never",
    "ship": "electron-builder build --publish always"
  },
  "author": "Thomas Ventimiglia",
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "asn1js": "^3.0.6",
    "cheerio": "^1.2.0",
    "csv": "^6.6.0",
    "electron-updater": "^6.8.9",
    "html-entities": "^2.6.0",
    "jsonpath-plus": "^10.4.0",
    "marcjs": "^3.0.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.22",
    "xpath": "^0.0.34"
  },
  "type": "module",
  "build": {
    "appId": "edu.princeton.liblookup",
    "publish": [
      {
        "provider": "github",
        "owner": "tventimi",
        "repo": "LibLookup"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "images/LL-icon.ico",
      "signtoolOptions": {
        "sign": "./customSign.cjs"
      }
    },
    "nsis": {
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "artifactName": "LibLookup-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "LibLookup-MacOS-Setup.${ext}",
      "icon": "images/LL-icon.icns",
      "notarize": true,
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
